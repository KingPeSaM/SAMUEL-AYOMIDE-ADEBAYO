rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow anyone to read the test connection document
    match /test/connection {
      allow read: if true;
    }

    // Products collection
    match /products/{productId} {
      // Anyone can read products (get and list)
      allow read: if true;
      
      // Only admin can create, update, or delete products
      allow create, update, delete: if request.auth != null && 
                                       (request.auth.token.email == "adebayosam3249@gmail.com" || 
                                        request.auth.token.email == "dopamuexcel@gmail.com") &&
                                       request.auth.token.email_verified == true;
    }
  }
}
